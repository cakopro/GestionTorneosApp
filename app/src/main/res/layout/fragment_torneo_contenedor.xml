<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".TorneoContenedorFragment">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="Pestañas de navegación del torneo"
        android:background="#FFFFFF"
        app:tabGravity="fill"
        app:tabMaxWidth="0dp"
        app:tabIndicatorColor="#1976D2"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="#1976D2"
        app:tabTextColor="#9E9E9E"
        app:tabMode="fixed" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>