<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DiagnosticoPruebas">

    <LinearLayout
        android:layout_width="282dp"
        android:layout_height="395dp"
        android:background="#737272"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20sp"
            android:text="Panel Diagnostico"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnFatal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20sp"
            android:text="Provocar Cierre" />

        <Button
            android:id="@+id/btnCrash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20sp"
            android:text="Registrar Error" />

        <Button
            android:id="@+id/btnToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obtener Token" />

        <Button
            android:id="@+id/btnSalirr"
            android:layout_width="77dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:foreground="@android:drawable/btn_dialog"
            android:text="Button"
            tools:layout_editor_absoluteX="289dp"
            tools:layout_editor_absoluteY="92dp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>